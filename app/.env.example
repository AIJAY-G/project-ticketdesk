# ==============================================================================
# TicketDesk Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT SECURITY REMINDER:
# - Copy this file to '.env' inside the 'app' directory for local configuration:
#     cp .env.example .env
# - NEVER commit '.env' containing real secrets, passwords, or credentials to Git!
# - The '.env' file is already excluded by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Phase 5)
# ------------------------------------------------------------------------------
# Option 1: Local Development (Default)
# Leave DATABASE_URL blank or commented out to use local SQLite (app/ticketdesk.db).
# DATABASE_URL=

# Option 2: PostgreSQL / Amazon RDS (Cloud Deployment)
# Format: postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# Example: postgresql+psycopg2://ticketdesk_admin:ChangeMe123!@localhost:5432/ticketdesk
DATABASE_URL=

# ------------------------------------------------------------------------------
# Storage Configuration - Amazon S3 (Phase 6)
# ------------------------------------------------------------------------------
# Leave blank for local disk storage in app/uploads/
# Set bucket name when integrating with Amazon S3
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# Application Admin Credentials (Initial Seeding)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
