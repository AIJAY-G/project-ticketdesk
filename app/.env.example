# ==============================================================================
# TicketDesk Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT SECURITY REMINDER:
# - Copy this file to '.env' inside the 'app' directory for local configuration:
#     cp .env.example .env
# - NEVER commit '.env' containing real secrets, passwords, or credentials to Git!
# - The '.env' file is already excluded by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Phase 5)
# ------------------------------------------------------------------------------
# Option 1: Local Development (Default)
# Leave DATABASE_URL blank or commented out to use local SQLite (app/ticketdesk.db).
# DATABASE_URL=

# Option 2: PostgreSQL / Amazon RDS (Cloud Deployment)
# Format: postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
# Example: postgresql+psycopg2://ticketdesk_admin:ChangeMe123!@localhost:5432/ticketdesk
DATABASE_URL=

# ------------------------------------------------------------------------------
# Storage Configuration - Amazon S3 & Local Fallback (Phase 6)
# ------------------------------------------------------------------------------
# Option 1: Local Storage (Default for local development)
# Leave S3_BUCKET_NAME blank or commented out to store files locally in app/uploads/.
# S3_BUCKET_NAME=

# Option 2: Amazon S3 Storage (AWS Deployment)
# Set to the S3 bucket provisioned by Terraform (e.g. ticketdesk-poc-attachments-xxxx)
#
# SECURITY & COMPLIANCE REQUIREMENTS:
# - S3 Bucket Privacy: The S3 bucket must remain strictly PRIVATE (all 4 S3 Block
#   Public Access controls enabled). Public bucket URLs are strictly forbidden.
# - Secure Retrieval: The application securely serves attachments via short-lived
#   Pre-signed URLs (15-minute expiration) generated on-demand for authorized users.
# - EC2 IAM Authentication: In AWS deployment, the application authenticates to S3
#   automatically via the attached EC2 IAM Instance Profile. Do NOT hardcode or
#   specify AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file or in code.
# - Validation Constraints:
#     - Allowed File Formats: .png, .jpg, .jpeg, .pdf, .txt, .log, .docx
#     - File Size Limit: 10 MB maximum per upload
S3_BUCKET_NAME=

# Target AWS Region for S3 and other AWS cloud resources (Default: ap-south-1)
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# Security, Authentication & Session Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 authentication tokens (JWT).
# Generate a strong 64-character secret in production using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Token expiration time in seconds (Default: 86400 = 24 hours)
TOKEN_EXPIRATION_SECONDS=86400

# Set to 'false' in production to strictly require Bearer token authentication
# and disable legacy dev header fallbacks.
ALLOW_DEV_HEADER_AUTH=false

# ------------------------------------------------------------------------------
# Application Admin Credentials & Account Seeding
# ------------------------------------------------------------------------------
# Set custom admin credentials for initial database setup.
# In production, change the password immediately. Passwords are automatically
# hashed using PBKDF2-HMAC-SHA256 (100,000 iterations). Plaintext is never stored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdminPass123!

# Whether to seed demo accounts (eng1, eng2, user1). Set to 'false' in production.
SEED_DEMO_ACCOUNTS=false
