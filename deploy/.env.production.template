# ==============================================================================
# TicketDesk EC2 Production Environment Configuration Template
# Target: Amazon Linux 2023 (/opt/ticketdesk/app/.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to /opt/ticketdesk/app/.env on the EC2 host.
# 2. Populate values using your Terraform outputs.
# 3. Secure file permissions:
#      sudo chmod 600 /opt/ticketdesk/app/.env
#      sudo chown ticketdesk:ticketdesk /opt/ticketdesk/app/.env
# 4. NEVER commit real secrets or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Amazon RDS PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<db_user>:<db_password>@<rds_address>:5432/<db_name>?sslmode=require
# Replace <rds_address> with terraform output "rds_address"
# Replace <db_password> with the password configured in terraform.tfvars
DATABASE_URL=postgresql+psycopg2://ticketdesk_admin:YOUR_STRONG_DB_PASSWORD_HERE@YOUR_RDS_ADDRESS_HERE:5432/ticketdesk?sslmode=require

# ------------------------------------------------------------------------------
# 2. Attachment Storage (Amazon S3)
# ------------------------------------------------------------------------------
# Replace with terraform output "s3_bucket_name"
# Authentication to S3 uses the attached EC2 IAM Instance Profile automatically.
# Do NOT configure static AWS access keys.
S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME_HERE
AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session
# ------------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 JWT token signing.
# Generate a strong 64-character secret using:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=YOUR_GENERATED_JWT_SECRET_KEY_HERE
SECRET_KEY=YOUR_GENERATED_JWT_SECRET_KEY_HERE
TOKEN_EXPIRATION_SECONDS=86400

# Strict production security setting: disable legacy header authentication
ALLOW_DEV_HEADER_AUTH=False

# ------------------------------------------------------------------------------
# 4. Application Administration & Account Seeding
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE
SEED_DEMO_ACCOUNTS=False
