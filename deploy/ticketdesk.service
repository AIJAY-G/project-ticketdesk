[Unit]
Description=TicketDesk FastAPI Application Service
After=network.target remote-fs.target
Documentation=https://github.com/AIJAY-G/project-ticketdesk

[Service]
Type=simple
User=ticketdesk
Group=ticketdesk
WorkingDirectory=/opt/ticketdesk
EnvironmentFile=/opt/ticketdesk/app/.env
ExecStart=/opt/ticketdesk/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=5s
KillSignal=SIGQUIT
TimeoutStopSec=10s

# Process Sandboxing & Hardening
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
LimitNOFILE=65535

# Logging via systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ticketdesk-app

[Install]
WantedBy=multi-user.target
