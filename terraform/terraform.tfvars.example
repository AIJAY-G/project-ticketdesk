# ==============================================================================
# Virtusa Project TicketDesk - Terraform Variable Values Example
# ==============================================================================
# Instructions:
# 1. Copy this file to 'terraform.tfvars' in the same directory:
#      cp terraform.tfvars.example terraform.tfvars
# 2. Customize the values below for your specific deployment.
# 3. IMPORTANT: 'terraform.tfvars' contains sensitive values and must
#    NEVER be committed to version control.
# ==============================================================================

aws_region   = "ap-south-1"
project_name = "ticketdesk"
environment  = "poc"

# VPC and Subnet Network Allocation
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones   = ["ap-south-1a", "ap-south-1b"]

# Application and Infrastructure Ports
http_port = 80
app_port  = 8000
ssh_port  = 22
db_port   = 5432

# Trusted Administrative SSH Ingress
# Replace with your actual trusted developer/admin IP address (e.g., "203.0.113.25/32").
# For security reasons, "0.0.0.0/0" is strictly disallowed.
# Leave as null or commented out if SSH access is not required.
allowed_ssh_cidr = null

# ==============================================================================
# Database Configuration (Amazon RDS PostgreSQL)
# ==============================================================================
db_name              = "ticketdesk"
db_username          = "ticketdesk_admin"
db_password          = "ProvideStrongPassword123!" # Required: Set a strong password in your local terraform.tfvars
db_instance_class    = "db.t4g.micro"              # Free Tier eligible (or db.t3.micro)
db_allocated_storage = 20                          # Minimum 20 GB for gp3
db_engine_version    = "15.7"

# ==============================================================================
# Compute Configuration (Amazon EC2 Application Server)
# ==============================================================================
ec2_instance_type    = "t3.micro" # Free Tier eligible (or t2.micro)
ec2_key_name         = null       # Optional: Name of an existing EC2 Key Pair (or null to use SSM)
ec2_root_volume_size = 20         # GB (gp3 encrypted root volume)

